---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { messages, staticLocalePaths, type Locale } from "../../data/i18n";
export function getStaticPaths() { return staticLocalePaths(); }
const { locale } = Astro.props as { locale: Locale };
const t = messages[locale];
const zh = locale === "zh-hant";
---
<BaseLayout locale={locale} title={`${t.footer.privacy}｜${t.common.brand}`} description={zh ? "BOYA 網站與 Desktop 的資料處理邊界。" : "BOYA 网站与 Desktop 的数据处理边界。"}>
  <PageHero eyebrow="Privacy" title={t.footer.privacy} description={zh ? "首版網站沒有帳號、分析追蹤或線上付款；Desktop 以本地工作區為核心。" : "首版网站没有账号、分析追踪或在线付款；Desktop 以本地工作区为核心。"} />
  <section class="band white"><article class="container prose">
    <h2>{zh ? "網站" : "网站"}</h2><p>{zh ? "BOYA 網站不設帳號、不放分析追蹤程式，也不直接處理付款。Cloudflare 可能依其基礎設施政策保存必要的請求與安全日誌。" : "BOYA 网站不设账号、不放分析追踪程序，也不直接处理付款。Cloudflare 可能按其基础设施政策保存必要的请求与安全日志。"}</p>
    <h2>Desktop</h2><p>{zh ? "選定的研究工作區與本地 Pi 工作階段保留在你的裝置。模型 API 金鑰存放在應用私人設定，不寫入工作區。Desktop 0.2 不載入 Skills、MCP 或 Notebook。當你主動使用模型或網路工具時，指令所需內容可能傳送到相應第三方服務，並受該服務政策約束。" : "选定的研究工作区与本地 Pi 工作阶段保留在你的设备。模型 API 密钥存放在应用私有设置，不写入工作区。Desktop 0.2 不载入 Skills、MCP 或 Notebook。当你主动使用模型或网络工具时，指令所需内容可能发送到对应第三方服务，并受该服务政策约束。"}</p>
    <h2>{zh ? "微信聯絡" : "微信联系"}</h2><p>{zh ? "透過微信聯絡作者時，聯絡資料由微信平台與作者依成交、入群及支援所需處理。網站本身不收集表單資料。" : "通过微信联系作者时，联系资料由微信平台与作者按成交、入群及支持所需处理。网站本身不收集表单资料。"}</p>
    <p class="muted">{zh ? "更新日期：2026 年 8 月 30 日" : "更新日期：2026 年 8 月 30 日"}</p>
  </article></section>
</BaseLayout>
