---
import { ArrowRight, Check, Download, GitFork } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePath, messages, staticLocalePaths, type Locale } from "../../data/i18n";
import { macAsset } from "../../data/release";

export function getStaticPaths() { return staticLocalePaths(); }
const { locale } = Astro.props as { locale: Locale };
const t = messages[locale];
const zh = locale === "zh-hant";
const copy = zh ? {
  description: "BOYA 博雅由兩個清楚分工的開源產品組成：免費 Skills 提供研究規則，BOYA Desktop 0.2 提供 macOS 本地 AI 工作台。",
  heroBody: "Skills 負責研究方法與寫作規則；Desktop 0.2 負責在你選定的本地資料夾裡與 Pi 對話、操作檔案和管理工作階段。研究判斷始終由你做。",
  heroNote: "Skills 永久免費 · Desktop 0.2 Preview",
  heroFacts: [
    ["本地工作區", "只在你選定的資料夾內讀寫。"],
    ["Pi 對話", "串流 Markdown、工具進度與可中止的工作階段。"],
    ["一次性核准", "Shell 指令與既有檔案覆寫都先等你確認。"],
  ],
  desktopScope: [
    ["平台", "macOS 13+ · Apple Silicon"],
    ["核心", "本地工作區與可切換的 Pi 對話"],
    ["權限", "每次操作清楚核准"],
  ],
  methodEyebrow: "不是全自動論文機",
  methodTitle: "把判斷留給研究者",
  methodBody: "BOYA 不替你選研究問題、來源、理論、方法、解釋或最終主張。Skills 是公開規則庫；Desktop 只提供受控的本地工作空間與 Pi 對話。",
  principles: [
    ["人類在環", "研究判斷明確留在你手上，不把學術決策藏進自動流程。"],
    ["本地優先", "Desktop 只在目前工作區操作，對話工作階段留在本機。"],
    ["邊界清楚", "Desktop 0.2 不載入 Skills、MCP、Notebook 或遠端運算。"],
  ],
  desktopEyebrow: "BOYA Desktop",
  desktopTitle: "一個精簡、本地優先的工作台",
  desktopBody: "BOYA Desktop 0.2 是 macOS Apple Silicon 的 Pi 用戶端：選定工作資料夾、開啟對話、查看串流回應與工具進度，必要時逐次核准操作。",
  features: ["macOS 13+ · Apple Silicon", "本地工作區與可切換的 Pi 對話", "串流 Markdown、工具進度與可中止操作", "既有檔案覆寫與 Shell 指令逐次核准"],
  skillsEyebrow: "BOYA Skills",
  skillsTitle: "規則庫與 Desktop，各自負責",
  skillsBody: "BOYA Skills 是公開倉庫的唯一真實來源，可以單獨安裝在支援的 Agent。Desktop 0.2 不載入 Skills；網站只同步公開倉庫的內容。",
  supportEyebrow: "需要作者直接協助？",
  supportTitle: "¥199／年的答疑群，買的是持續服務",
  supportBody: "Skills 不收費。作者答疑群提供安裝與使用答疑、版本更新導讀和案例交流。",
} : {
  description: "BOYA 博雅由两个清楚分工的开源产品组成：免费 Skills 提供研究规则，BOYA Desktop 0.2 提供 macOS 本地 AI 工作台。",
  heroBody: "Skills 负责研究方法与写作规则；Desktop 0.2 负责在你选定的本地文件夹里与 Pi 对话、操作文件和管理工作阶段。研究判断始终由你做。",
  heroNote: "Skills 永久免费 · Desktop 0.2 Preview",
  heroFacts: [
    ["本地工作区", "只在你选定的文件夹内读写。"],
    ["Pi 对话", "串流 Markdown、工具进度与可中止的工作阶段。"],
    ["一次性核准", "Shell 命令与已有文件覆盖都先等你确认。"],
  ],
  desktopScope: [
    ["平台", "macOS 13+ · Apple Silicon"],
    ["核心", "本地工作区与可切换的 Pi 对话"],
    ["权限", "每次操作清楚核准"],
  ],
  methodEyebrow: "不是全自动论文机",
  methodTitle: "把判断留给研究者",
  methodBody: "BOYA 不替你选研究问题、来源、理论、方法、解释或最终主张。Skills 是公开规则库；Desktop 只提供受控的本地工作空间与 Pi 对话。",
  principles: [
    ["人类在环", "研究判断明确留在你手上，不把学术决策藏进自动流程。"],
    ["本地优先", "Desktop 只在当前工作区操作，对话工作阶段留在本机。"],
    ["边界清楚", "Desktop 0.2 不载入 Skills、MCP、Notebook 或远程运算。"],
  ],
  desktopEyebrow: "BOYA Desktop",
  desktopTitle: "一个精简、本地优先的工作台",
  desktopBody: "BOYA Desktop 0.2 是 macOS Apple Silicon 的 Pi 客户端：选择工作文件夹、打开对话、查看串流回应与工具进度，必要时逐次核准操作。",
  features: ["macOS 13+ · Apple Silicon", "本地工作区与可切换的 Pi 对话", "串流 Markdown、工具进度与可中止操作", "已有文件覆盖与 Shell 命令逐次核准"],
  skillsEyebrow: "BOYA Skills",
  skillsTitle: "规则库与 Desktop，各自负责",
  skillsBody: "BOYA Skills 是公开仓库的唯一真实来源，可以单独安装在支持的 Agent。Desktop 0.2 不载入 Skills；网站只同步公开仓库的内容。",
  supportEyebrow: "需要作者直接协助？",
  supportTitle: "¥199／年的答疑群，买的是持续服务",
  supportBody: "Skills 不收费。作者答疑群提供安装与使用答疑、版本更新导读和案例交流。",
};
---
<BaseLayout locale={locale} title={`${t.common.brand}｜${t.common.tagline}`} description={copy.description}>
  <section class="home-hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{t.common.tagline}</p>
        <h1>{t.common.brand}</h1>
        <p class="lede">{copy.heroBody}</p>
        <div class="button-row">
          <a class="button" href={macAsset?.url || `${localePath(locale, "desktop")}#download`}><Download size={18} />{t.action.download}</a>
          <a class="button secondary" href={localePath(locale, "skills")}><GitFork size={18} />{t.action.skills}</a>
        </div>
        <div class="hero-note"><span aria-hidden="true"></span>{copy.heroNote}</div>
      </div>
      <div class="hero-facts" aria-label={copy.desktopEyebrow}>
        <p class="eyebrow">BOYA Desktop 0.2</p>
        {copy.heroFacts.map(([title, body], index) => <div class="hero-fact"><span class="hero-fact-number">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></div>)}
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">{copy.methodEyebrow}</p><h2>{copy.methodTitle}</h2></div>
        <p class="lede">{copy.methodBody}</p>
      </div>
      <div class="principles">
        {copy.principles.map(([title, body], index) => <article class="principle"><span class="principle-number">0{index + 1}</span><h3>{title}</h3><p class="muted">{body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container product-band">
      <div class="product-scope">
        <div class="product-scope-header"><span>BOYA Desktop</span><span>0.2 Preview</span></div>
        {copy.desktopScope.map(([label, value]) => <div class="product-scope-row"><span>{label}</span><strong>{value}</strong></div>)}
      </div>
      <div>
        <p class="eyebrow">{copy.desktopEyebrow}</p>
        <h2>{copy.desktopTitle}</h2>
        <p class="muted">{copy.desktopBody}</p>
        <ul class="feature-list">{copy.features.map((item) => <li><Check size={17} /><span>{item}</span></li>)}</ul>
        <a class="button" href={localePath(locale, "desktop")}>{t.common.learnMore}<ArrowRight size={18} /></a>
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="container section-heading">
      <div><p class="eyebrow">{copy.skillsEyebrow}</p><h2>{copy.skillsTitle}</h2></div>
      <div><p class="lede">{copy.skillsBody}</p><div class="button-row"><a class="button secondary" href={localePath(locale, "skills")}>{t.action.skills}<ArrowRight size={18} /></a><a class="button ghost" href="https://github.com/DylanChiang-Dev/BOYA-skills">GitHub <GitFork size={17} /></a></div></div>
    </div>
  </section>

  <section class="band dark">
    <div class="container section-heading">
      <div><p class="eyebrow">{copy.supportEyebrow}</p><h2>{copy.supportTitle}</h2></div>
      <div><p class="lede">{copy.supportBody}</p><a class="button" href={localePath(locale, "community")}>{t.action.contact}<ArrowRight size={18} /></a></div>
    </div>
  </section>
</BaseLayout>
