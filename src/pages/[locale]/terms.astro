---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { messages, staticLocalePaths, type Locale } from "../../data/i18n";
export function getStaticPaths() { return staticLocalePaths(); }
const { locale } = Astro.props as { locale: Locale };
const t = messages[locale];
const zh = locale === "zh-hant";
---
<BaseLayout locale={locale} title={`${t.footer.terms}｜${t.common.brand}`} description={zh ? "BOYA Skills、Desktop Preview 與作者答疑群的使用和退款條款。" : "BOYA Skills、Desktop Preview 与作者答疑群的使用和退款条款。"}>
  <PageHero eyebrow="Terms" title={t.footer.terms} description={zh ? "免費軟體、預覽版與付費支援各自有清楚邊界。" : "免费软件、预览版与付费支持各自有清楚边界。"} />
  <section class="band white"><article class="container prose">
    <h2>BOYA Skills</h2><p>{zh ? "BOYA Skills 依 MIT 授權免費提供。作者答疑群不是 Skills 的授權費，也不限制任何人自行下載、修改或使用公開內容。" : "BOYA Skills 依据 MIT 许可免费提供。作者答疑群不是 Skills 的授权费，也不限制任何人自行下载、修改或使用公开内容。"}</p>
    <h2>Desktop Preview</h2><p>{zh ? "Desktop Preview 免費提供、尚未簽名與公證，可能有錯誤或不完整功能。使用前應備份重要研究材料；預覽版不提供適售性、特定目的適用性或不中斷保證。" : "Desktop Preview 免费提供、尚未签名与公证，可能有错误或不完整功能。使用前应备份重要研究材料；预览版不提供适销性、特定目的适用性或不中断保证。"}</p>
    <h2>{zh ? "作者答疑群" : "作者答疑群"}</h2><p>{zh ? "費用為人民幣 ¥199／12 個月，包含安裝與使用答疑、版本更新導讀和案例交流。不包含代寫、代做研究、替使用者作學術判斷、固定回覆時限或任何畢業與錄用保證。" : "费用为人民币 ¥199／12 个月，包含安装与使用答疑、版本更新导读和案例交流。不包含代写、代做研究、替用户作学术判断、固定回复时限或任何毕业与录用保证。"}</p>
    <h2>{zh ? "退款" : "退款"}</h2><p>{zh ? "付款後、尚未入群且未開始答疑前，可聯絡作者申請全額退款。入群或服務開始後，視為數位服務已交付，不再退款。" : "付款后、尚未入群且未开始答疑前，可联系作者申请全额退款。入群或服务开始后，视为数字服务已交付，不再退款。"}</p>
    <h2>{zh ? "學術責任" : "学术责任"}</h2><p>{zh ? "研究問題、來源選擇、理論、方法、解釋、主張與最終提交始終由研究者負責。BOYA 不保證內容正確、研究通過審查或取得特定成果。" : "研究问题、来源选择、理论、方法、解释、主张与最终提交始终由研究者负责。BOYA 不保证内容正确、研究通过审查或取得特定成果。"}</p>
    <p class="muted">{zh ? "更新日期：2026 年 7 月 14 日" : "更新日期：2026 年 7 月 14 日"}</p>
  </article></section>
</BaseLayout>
